# --- Inference (cloud only, Groq) ---
# One key for everything. Never commit a real key.
GROQ_API_KEY=

# Open-weight models served via Groq (this prompt wins over docs).
VLM_MODEL=qwen/qwen3-vl-32b
VLM_FALLBACK_MODEL=qwen/qwen3-vl-32b
LLM_MODEL=openai/gpt-oss-20b

# --- Auth (Stage 2; seeded demo user + static token header) ---
# Backend sends/verifies this header; user_id is always derived server-side.
DEMO_AUTH_TOKEN=demo-token-change-me

# --- Storage ---
APP_ENV=development
DATABASE_URL=sqlite:///./data/app.db
EVIDENCE_DIR=./data/evidence

# --- Perception gate (IMPLEMENTATION.md section 5, starting points) ---
FRAME_SAMPLE_FPS=3
CHANGE_THRESHOLD=0.12
EVENT_COOLDOWN_SECONDS=8
PRE_EVENT_SECONDS=3
POST_EVENT_SECONDS=1

# --- Frontend dev switch (Stage 2) ---
# MOCK_MODE=true emits fake scene/event WS messages before the real pipeline exists.
MOCK_MODE=false
