# ===================== Visual Memory backend env =====================
# Copy to .env and fill in. NEVER expose GROQ_API_KEY or
# SUPABASE_SERVICE_ROLE_KEY to the browser/frontend.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
# Runtime mode: local (hackathon demo) or live (production).
# LOCAL = SQLite + local evidence + local auth + real Groq AI (LOCAL != MOCK).
# LIVE = Supabase Auth/Postgres/pgvector/Storage; fails fast without vars.
VISTARA_MODE=local
# Comma-separated browser origins allowed in non-development APP_ENV
# (the deployed frontend). Example: CORS_ORIGINS=https://vistara.vercel.app
CORS_ORIGINS=

# --- Local demo (VISTARA_MODE=local) ---
# Persistent SQLite for the demo (DATABASE_URL wins when set).
# LOCAL_DATABASE_URL=sqlite:///./data/vistara.db
# Local evidence directory.
# LOCAL_EVIDENCE_DIR=./data/evidence
# Recorded-video demo source. Supplied by the user; validated at startup.
DEMO_VIDEO_PATH=./video.mp4
# Demo playback speed (1.0 = real-time). Source timestamps are preserved.
VIDEO_PLAYBACK_SPEED=1.0
# Loop the video at EOF (same logical camera, no duplicate baseline).
VIDEO_LOOP=false

# --- Supabase (Auth + Postgres + pgvector + Storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification (Project Settings -> API -> JWT Settings). HS256 legacy secret.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_EVIDENCE_BUCKET=evidence
# Postgres connection string (Supabase -> Database -> Connection string).
# Use the pooler URI in production. Example:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Groq (cloud-only, open-weight models) ---
GROQ_API_KEY=
GROQ_VLM_MODEL=qwen/qwen3.8-27b
GROQ_VLM_FALLBACK_MODEL=qwen/qwen3.8-27b
# Phase 2 verified: qwen3.8-27b truncates strict-JSON output at "none"; "low" works.
GROQ_VLM_REASONING_EFFORT=low
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60

# --- Local perception gate ---
FRAME_SAMPLE_FPS=2
CHANGE_THRESHOLD=0.02
PERSISTENCE_FRAMES=2
USE_SSIM=false
BUFFER_SECONDS=3
PRE_EVENT_SECONDS=3
POST_EVENT_SECONDS=2
COOLDOWN_SECONDS=8

# --- VLM payload resolutions (max side px, JPEG q=85) ---
# Payload: 1 high-res current frame + 1-2 low-res context frames + change-region crop.
VLM_MAIN_MAX_SIDE=1024
VLM_CONTEXT_MAX_SIDE=512
VLM_CROP_MAX_SIDE=768
VLM_JPEG_QUALITY=85
VLM_CROP_PADDING_PX=24

# --- Initial visual baseline (once per logical camera) ---
# Warm-up frames/seconds before the baseline may finalize; stability needs
# settled_frames consecutive sub-threshold gate scores; max_wait bounds settling.
BASELINE_WARMUP_FRAMES=5
BASELINE_WARMUP_SECONDS=3.0
BASELINE_SETTLED_THRESHOLD=0.03
BASELINE_SETTLED_FRAMES=3
BASELINE_MAX_WAIT_SECONDS=20.0
BASELINE_CONTEXT_FRAMES=3
BASELINE_MAX_ATTEMPTS=5
BASELINE_RETRY_COOLDOWN_SECONDS=30.0

# --- Camera connectivity hardening ---
# WebSocket frame caps + ingest sampling (preview may exceed; AI stays gate-driven).
WS_MAX_FRAME_BYTES=5242880
WS_MAX_IMAGE_DIM=4096
INGEST_MAX_FPS=5
# Bounded per-camera event queue (drop-oldest when full).
EVENT_QUEUE_MAXSIZE=4
# Phone QR pairing session lifetime.
PAIRING_TTL_SECONDS=600
# SSRF policy: allow loopback/private stream hosts (self-hosted LAN cameras/NVR).
# Keep false unless the deployment intentionally serves LAN cameras.
CAMERAS_ALLOW_PRIVATE_NETWORKS=false

# --- Dev/test switch ---
# MOCK_MODE=true uses offline mock providers (no Groq) and a static demo token.
MOCK_MODE=false