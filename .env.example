# ===================== Visual Memory backend env =====================
# Copy to .env and fill in. NEVER expose GROQ_API_KEY or
# SUPABASE_SERVICE_ROLE_KEY to the browser/frontend.

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Supabase (Auth + Postgres + pgvector + Storage) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# JWT verification (Project Settings -> API -> JWT Settings). HS256 legacy secret.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_EVIDENCE_BUCKET=evidence
# Postgres connection string (Supabase -> Database -> Connection string).
# Use the pooler URI in production. Example:
# DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Groq (cloud-only, open-weight models) ---
GROQ_API_KEY=
GROQ_VLM_MODEL=qwen/qwen3.8-27b
GROQ_VLM_FALLBACK_MODEL=qwen/qwen3.8-27b
GROQ_CHAT_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60

# --- Local perception gate ---
FRAME_SAMPLE_FPS=2
CHANGE_THRESHOLD=0.02
PERSISTENCE_FRAMES=2
USE_SSIM=false
BUFFER_SECONDS=3
PRE_EVENT_SECONDS=3
POST_EVENT_SECONDS=2
COOLDOWN_SECONDS=8

# --- VLM payload resolutions (max side px, JPEG q=85) ---
# Payload: 1 high-res current frame + 1-2 low-res context frames + change-region crop.
VLM_MAIN_MAX_SIDE=1024
VLM_CONTEXT_MAX_SIDE=512
VLM_CROP_MAX_SIDE=768
VLM_JPEG_QUALITY=85
VLM_CROP_PADDING_PX=24

# --- Dev/test switch ---
# MOCK_MODE=true uses offline mock providers (no Groq) and a static demo token.
MOCK_MODE=false